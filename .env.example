# To separate your traces from other application
LANGSMITH_PROJECT=rag-research-agent

# The following depend on your selected configuration

# LLM & Embedding choice:
GEMINI_API_KEY=your_gemini_api_key_here

# Retrieval provider (Default: 'chroma' embedded zero-config vector store)
# Chroma runs in-process and persists vectors automatically to ./data/chroma

# Web Research Tool (Default: 'duckduckgo' zero-config search)
# Default requires ZERO additional API keys.
ENABLE_WEB_SEARCH=true

## Optional Web Search Production Providers:
# TAVILY_API_KEY=your_tavily_api_key_here
# SERPER_API_KEY=your_serper_api_key_here

## Optional External Vector Providers:
## Elastic cloud:
# ELASTICSEARCH_URL=...
# ELASTICSEARCH_API_KEY=...

## Pinecone:
# PINECONE_API_KEY=...
# PINECONE_INDEX_NAME=...

## Mongo Atlas:
# MONGODB_URI=...

